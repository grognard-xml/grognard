{
  "extends": "./electron-builder.base.json",
  "artifactName": "Grognard-linux-flatpak-${version}-${arch}.${ext}",
  "linux": {
    "target": ["flatpak"],
    "icon": "icons",
    "category": "Office",
    "syncDesktopName": true,
    "maintainer": "Daniel Patrick Morgan <daniel.morgan@college-de-france.fr>",
    "extraResources": [
      {
        "from": "resources/python",
        "to": "python",
        "filter": ["**/*", "!.deps-installed"]
      }
    ]
  },
  "flatpak": {
    "runtimeVersion": "24.08",
    "baseVersion": "24.08",
    "useWaylandFlags": true,
    "finishArgs": [
      "--socket=wayland",
      "--socket=x11",
      "--share=ipc",
      "--device=dri",
      "--socket=pulseaudio",
      "--filesystem=home",
      "--share=network",
      "--talk-name=org.freedesktop.Notifications",
      "--talk-name=org.freedesktop.secrets"
    ]
  },
  "win": {
    "target": ["nsis"]
  }
}
