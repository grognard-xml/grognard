{
  "name": "@cwrc/leafwriter-validator",
  "version": "0.0.1",
  "description": "webworker to handle validation on Leaf-Writer",
  "keywords": [
    "xml",
    "rdf",
    "editor",
    "annotation",
    "rng validation"
  ],
  "homepage": "https://github.com/grognard-xml/grognard",
  "bugs": {
    "url": "https://github.com/grognard-xml/grognard/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/grognard-xml/grognard.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "AGPL-3.0-only",
  "author": "Daniel Patrick Morgan (CNRS)",
  "exports": {
    ".": {
      "import": [
        "./src/index.worker",
        "./lib/index.worker"
      ],
      "require": "./dist/leafwriter-validator.worker.js"
    }
  },
  "types": "lib/index.worker.d.ts",
  "module": "src/index.worker.ts",
  "files": [
    "dist",
    "lib"
  ],
  "scripts": {
    "browserify-jsdom": "browserify -r jsdom -s jsdom -o src/lib/jsdom/jsdom-browserified.js",
    "build": "npm run clean && tsup && tsc --emitDeclarationOnly --declaration && webpack",
    "clean": "npx rimraf dist lib docs",
    "format": "prettier --write \"**/*.{ts,md}\"",
    "format-check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test-watch": "jest --watchAll --verbose",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@cwrc/salve-dom-leafwriter": "^6.0.3",
    "@cwrc/salve-leafwriter": "^1.2.2",
    "comlink": "^4.4.2",
    "dexie": "^4.3.0",
    "lodash": "^4.17.23",
    "loglevel": "^1.9.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.17.24",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.3.3",
    "browserify": "^17.0.1",
    "clean-webpack-plugin": "^4.0.0",
    "esbuild-loader": "^4.4.2",
    "eslint": "^10.9.0",
    "eslint-config-custom": "*",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-fetch-mock": "^3.0.3",
    "jsdom": "^26.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "webpack": "^5.105.4",
    "webpackbar": "^7.0.0"
  },
  "peerDependencies": {
    "comlink": "^4.4.2"
  }
}
